class Solution {
    boolean hasCycle = false; 
 
    public void rec(ArrayList<ArrayList<Integer>> adj, int u, boolean[] vis, boolean[] inrec) {
        if (hasCycle) return; 
 
        vis[u] = true;
        inrec[u] = true;
 
        for (int nbr : adj.get(u)) {
            if (!vis[nbr]) rec(adj, nbr, vis, inrec);
            else if (inrec[nbr]) {
                hasCycle = true;
                return;
            }
        }
 
        inrec[u] = false;
    }

    public boolean canFinish(int numCourses, int[][] prerequisites) {
        boolean[] vis = new boolean[numCourses];
        boolean[] inrec = new boolean[numCourses];
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
 
        for (int i = 0; i < numCourses; i++)
            adj.add(new ArrayList<>());

        for (int[] x : prerequisites) {
            int a = x[0];
            int b = x[1];
            adj.get(b).add(a);
        }
 
        for (int i = 0; i < numCourses; i++) {
            if (!vis[i]) rec(adj, i, vis, inrec);
            if (hasCycle) return false; 
        }
 
        return true; 
    }
}
